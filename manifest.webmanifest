{
  "name": "Shuffl",
  "short_name": "Shuffl",
  "description": "Aleatorio de verdad para tus playlists.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0B0B0B",
